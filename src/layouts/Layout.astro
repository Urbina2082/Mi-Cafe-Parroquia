---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <script async src="https://www.googletagmanager.com/gtm.js?id=GTM-P3GSX749"
    ></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      property="og:image"
      content="https://mi-cafe-parroquia.vercel.app/icon.jpg"
    />

    <meta
      name="description"
      content="Mi Café Parroquia es un acogedor café ubicado en el corazón de la ciudad, ofreciendo una experiencia única con café de alta calidad, deliciosos postres y un ambiente cálido y amigable. Ven y disfruta de nuestro menú cuidadosamente seleccionado y de la hospitalidad que nos caracteriza."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/logo.avif" />
    <meta name="generator" content={Astro.generator} />
    <title>Mi Cafe Parroquia</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
<style is:global>
  :root {
    --color-bg: #2b140b;
    --color-bg-light: #3b1e12;
    --color-glass: rgba(255, 239, 220, 0.07);
    --color-border: rgba(255, 232, 210, 0.18);
    --color-text: #fff7ed;
    --color-muted: #c9b6a7;
    --color-gold: #d6a56e;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    background: var(--color-bg);
  }

  body {
    margin: 0;
    min-height: 100vh;
    color: var(--color-text);

    /* Degradados radiales para el brillo cálido y fondo degradado lineal */
    background:
      radial-gradient(
        ellipse at 50% 0%,
        rgba(132, 67, 35, 0.22),
        transparent 55%
      ),
      radial-gradient(
        ellipse at 0% 45%,
        rgba(105, 48, 24, 0.15),
        transparent 50%
      ),
      linear-gradient(180deg, #351b10 0%, #2b140b 50%, #241008 100%);

    background-attachment: fixed;
    font-family: "Inter", sans-serif;
  }

  ::selection {
    background: rgba(214, 165, 110, 0.35);
    color: white;
  }
</style>
