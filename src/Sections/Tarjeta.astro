---
const {
  etiqueta = "PAGOS",
  titulo = "Transferencias y pagos",
  descripcion = "Realiza tu transferencia bancaria con los siguientes datos.",
  aviso = "Verifica los datos antes de realizar tu transferencia.",
} = Astro.props;

const tarjeta = "4152 3142 4631 8672";
const titular = " Silvia Hernández F.";
const banco = "BBVA";
---

<section class="pagos" id="pagos">
  <div class="pagos-container">

    <header class="pagos-header">
      <span class="pagos-etiqueta">{etiqueta}</span>
      <h2>{titulo}</h2>
      <p>{descripcion}</p>
    </header>

    <div class="pagos-card">

      <div class="pagos-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36"
          viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="5" width="20" height="14" rx="2"/>
          <path d="M2 10h20"/>
          <path d="M6 15h3"/>
        </svg>
      </div>

      <span class="pagos-banco">{banco}</span>

      <div class="pagos-datos">

        <div class="dato">
          <span class="dato-label">Número de tarjeta</span>

          <div class="dato-valor tarjeta-valor">
            <strong>{tarjeta}</strong>

            <button
              class="copiar-btn"
              type="button"
              data-copy={tarjeta.replaceAll(" ", "")}
              aria-label="Copiar número de tarjeta"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17"
                viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="8" y="8" width="13" height="13" rx="2"/>
                <path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"/>
              </svg>
              <span>Copiar</span>
            </button>
          </div>
        </div>

        <div class="dato">
          <span class="dato-label">Titular de la cuenta</span>
          <strong class="dato-titular">{titular}</strong>
        </div>

        <div class="dato">
          <span class="dato-label">Institución bancaria</span>
          <strong class="dato-banco">{banco}</strong>
        </div>

      </div>

      <p class="pagos-aviso">{aviso}</p>

    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>(".copiar-btn").forEach((boton) => {
    boton.addEventListener("click", async () => {
      const texto = boton.dataset.copy;
      if (!texto) return;

      try {
        await navigator.clipboard.writeText(texto);

        const textoOriginal = boton.innerHTML;
        boton.innerHTML = "✓ Copiado";

        setTimeout(() => {
          boton.innerHTML = textoOriginal;
        }, 1800);
      } catch {
        boton.querySelector("span")!.textContent = "No disponible";
      }
    });
  });
</script>

<style>
  .pagos {
    width: 100%;
    padding: 45px 24px;
    box-sizing: border-box;
    background: transparent;
    color: #fff8f0;
  }

  .pagos-container {
    width: 100%;
    max-width: 850px;
    margin: 0 auto;
  }

  .pagos-header {
    text-align: center;
    margin-bottom: 28px;
  }

  .pagos-etiqueta {
    display: block;
    margin-bottom: 12px;
    color: #d9a66e;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 5px;
  }

  .pagos-header h2 {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(32px, 4vw, 46px);
    font-weight: 400;
    line-height: 1.15;
  }

  .pagos-header p {
    margin: 12px auto 0;
    color: rgba(255, 245, 235, 0.7);
    font-size: 15px;
    line-height: 1.6;
  }

  .pagos-card {
    width: 100%;
    max-width: 680px;
    margin: 0 auto;
    padding: 32px;
    box-sizing: border-box;

    display: flex;
    flex-direction: column;
    align-items: center;

    background: rgba(116, 65, 43, 0.3);
    border: 1px solid rgba(222, 183, 151, 0.32);
    border-radius: 27px;

    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.04),
      0 15px 35px rgba(0, 0, 0, 0.08);
  }

  .pagos-icon {
    display: flex;
    justify-content: center;
    color: #d9a66e;
    margin-bottom: 12px;
  }

  .pagos-banco {
    color: #d9a66e;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 3px;
    margin-bottom: 23px;
  }

  .pagos-datos {
    width: 100%;
    max-width: 480px;
    display: flex;
    flex-direction: column;
    gap: 13px;
  }

  .dato {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 15px 17px;

    border: 1px solid rgba(222, 183, 151, 0.2);
    border-radius: 15px;
    background: rgba(255, 255, 255, 0.035);
  }

  .dato-label {
    color: rgba(255, 245, 235, 0.57);
    font-size: 12px;
  }

  .dato-valor {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .dato-valor strong,
  .dato-titular,
  .dato-banco {
    color: #fff8f0;
    font-size: 16px;
    font-weight: 500;
  }

  .tarjeta-valor strong {
    font-size: clamp(15px, 2.2vw, 19px);
    letter-spacing: 1.5px;
    font-variant-numeric: tabular-nums;
  }

  .copiar-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    flex-shrink: 0;
    padding: 9px 12px;

    border: 1px solid rgba(217, 166, 110, 0.3);
    border-radius: 10px;
    background: rgba(217, 166, 110, 0.1);

    color: #e5bb8c;
    font-size: 12px;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .copiar-btn:hover {
    background: rgba(217, 166, 110, 0.2);
  }

  .pagos-aviso {
    margin: 22px 0 0;
    color: rgba(255, 245, 235, 0.55);
    text-align: center;
    font-size: 12px;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .pagos {
      padding: 40px 20px;
    }

    .pagos-card {
      padding: 28px 23px;
    }
  }

  @media (max-width: 480px) {
    .pagos {
      padding: 35px 17px;
    }

    .pagos-header {
      margin-bottom: 23px;
    }

    .pagos-header h2 {
      font-size: 34px;
    }

    .pagos-header p {
      font-size: 14px;
    }

    .pagos-card {
      padding: 25px 17px;
      border-radius: 23px;
    }

    .dato {
      padding: 13px;
    }

    .dato-valor strong {
      font-size: 14px;
    }

    .tarjeta-valor strong {
      font-size: 14px;
      letter-spacing: 0.5px;
    }

    .copiar-btn {
      padding: 8px;
      font-size: 11px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .copiar-btn {
      transition: none;
    }
  }
</style>
