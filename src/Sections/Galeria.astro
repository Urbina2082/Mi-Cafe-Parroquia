---

const fotosDefault = [
  {
    src: "/6.jpeg",
    alt: "",
    className: "gallery-item--feature",
  },
  {
    src: "/7.jpeg",
    alt: "",
    className: "gallery-item--portrait",
  },
  {
    src: "/8.jpeg",
    alt: "",
    className: "gallery-item--top",
  },
  {
    src: "/9.jpeg",
    alt: "",
    className: "gallery-item--middle",
  },
  {
    src: "/10.jpeg",
    alt: "",
    className: "gallery-item--bottom",
  },
  {
    src: "/11.jpg",
    alt: "",
    className: "gallery-item--bottom",
  },
  {
    src: "/12.jpeg",
    alt: "",
    className: "gallery-item--bottom",
  },
];

const { images = fotosDefault } = Astro.props;

const fotos = images.map((foto, index) => ({
  ...foto,
  className:
    foto.className ??
    (index === 0
      ? "gallery-item--feature"
      : "gallery-item--bottom"),
}));
---

<section class="gallery-section" id="galeria" aria-labelledby="gallery-title">

  <div class="gallery-heading">
    <span class="gallery-eyebrow">GALERÍA</span>

    <h2 id="gallery-title">
      Momentos con sabor
    </h2>

    <p>
      Un vistazo a los sabores y momentos que compartimos contigo.
    </p>
  </div>

  <div class="gallery-grid">

    {fotos.map((foto, index) => (
      <button
        class={`gallery-item ${foto.className}`}
        type="button"
        data-gallery-index={index}
        aria-label={`Ver fotografía: ${foto.alt}`}
      >
        <img
          src={foto.src}
          alt={foto.alt}
          loading={index === 0 ? "eager" : "lazy"}
          decoding="async"
        />

        <span class="gallery-item-overlay" aria-hidden="true">
          <span class="gallery-zoom-icon">+</span>
        </span>
      </button>
    ))}

  </div>
</section>

<!-- VISOR DE FOTOGRAFÍAS -->

<div class="gallery-lightbox" data-lightbox aria-hidden="true">

  <button
    class="lightbox-close"
    type="button"
    aria-label="Cerrar fotografía"
    data-lightbox-close
  >
    &times;
  </button>

  <button
    class="lightbox-nav lightbox-prev"
    type="button"
    aria-label="Fotografía anterior"
    data-lightbox-prev
  >
    &#10094;
  </button>

  <figure class="lightbox-figure">
    <img src="" alt="" data-lightbox-image />

    <figcaption data-lightbox-caption></figcaption>
  </figure>

  <button
    class="lightbox-nav lightbox-next"
    type="button"
    aria-label="Fotografía siguiente"
    data-lightbox-next
  >
    &#10095;
  </button>

  <span class="lightbox-counter" data-lightbox-counter></span>

</div>

<style>
  /* =========================================
     GALERÍA
  ========================================= */

  .gallery-section {
    --gallery-card: #4a291b;
    --gallery-border: rgba(226, 193, 163, 0.28);
    --gallery-cream: #fff7ed;
    --gallery-gold: #d9a66d;

    position: relative;
    isolation: isolate;
    overflow: hidden;

    padding: clamp(4.5rem, 8vw, 7rem)
      clamp(1.1rem, 4.5vw, 5rem);

    color: var(--gallery-cream);

    /* Fondo eliminado: utiliza el fondo global del Layout */
    background: transparent;
  }

  /* =========================================
     ENCABEZADO
  ========================================= */

  .gallery-heading {
    max-width: 760px;
    margin: 0 auto clamp(2.5rem, 4vw, 3.5rem);
    text-align: center;
  }

  .gallery-eyebrow {
    display: block;
    margin-bottom: 0.8rem;

    color: var(--gallery-gold);

    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.38em;
  }

  .gallery-heading h2 {
    margin: 0;

    color: var(--gallery-cream);

    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.035em;
  }

  .gallery-heading p {
    margin: 1rem 0 0;

    color: rgba(255, 247, 237, 0.66);

    font-size: clamp(0.9rem, 1.2vw, 1.05rem);
    line-height: 1.7;
  }

  /* =========================================
     GRID DE FOTOGRAFÍAS
  ========================================= */

  .gallery-grid {
    display: grid;

    width: min(100%, 1260px);
    margin-inline: auto;

    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: repeat(3, clamp(145px, 17vw, 220px));

    gap: clamp(0.65rem, 1vw, 1rem);
  }

  /* =========================================
     TARJETAS
  ========================================= */

  .gallery-item {
    position: relative;

    display: block;

    min-width: 0;
    min-height: 0;

    overflow: hidden;
    padding: 0;

    border: 1px solid var(--gallery-border);
    border-radius: clamp(1.1rem, 1.8vw, 1.65rem);

    background: var(--gallery-card);

    cursor: zoom-in;
    isolation: isolate;

    -webkit-tap-highlight-color: transparent;
  }

  .gallery-item img {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;

    transition:
      transform 700ms cubic-bezier(0.2, 0.7, 0.2, 1),
      filter 500ms ease;
  }

  .gallery-item:hover img,
  .gallery-item:focus-visible img {
    transform: scale(1.065);
    filter: brightness(0.82);
  }

  .gallery-item:focus-visible {
    outline: 2px solid var(--gallery-gold);
    outline-offset: 4px;
  }

  /* =========================================
     EFECTO OVERLAY
  ========================================= */

  .gallery-item-overlay {
    position: absolute;
    inset: 0;

    display: grid;
    place-items: center;

    background:
      linear-gradient(
        180deg,
        transparent 45%,
        rgba(22, 10, 5, 0.35)
      );

    opacity: 0;

    transition: opacity 350ms ease;
  }

  .gallery-item:hover .gallery-item-overlay,
  .gallery-item:focus-visible .gallery-item-overlay {
    opacity: 1;
  }

  .gallery-zoom-icon {
    display: grid;

    width: 2.8rem;
    aspect-ratio: 1;

    place-items: center;

    border: 1px solid rgba(255, 247, 237, 0.65);
    border-radius: 50%;

    color: white;
    background: rgba(65, 34, 21, 0.48);

    font-size: 1.8rem;
    font-weight: 300;

    backdrop-filter: blur(12px);
  }

  /* =========================================
     DISTRIBUCIÓN COMPUTADORA
  ========================================= */

  .gallery-item--feature {
    grid-column: 1 / span 2;
    grid-row: 1 / span 2;
  }

  .gallery-item--portrait {
    grid-column: 3;
    grid-row: 1 / span 2;
  }

  .gallery-item--top {
    grid-column: 4;
    grid-row: 1;
  }

  .gallery-item--middle {
    grid-column: 4;
    grid-row: 2;
  }

  .gallery-item--bottom:nth-of-type(5) {
    grid-column: 1;
    grid-row: 3;
  }

  .gallery-item--bottom:nth-of-type(6) {
    grid-column: 2;
    grid-row: 3;
  }

  .gallery-item--bottom:nth-of-type(7) {
    grid-column: 3;
    grid-row: 3;
  }

  /* =========================================
     LIGHTBOX / VISOR
  ========================================= */

  .gallery-lightbox {
    position: fixed;
    z-index: 9999;
    inset: 0;

    display: grid;

    grid-template-columns: auto minmax(0, 1fr) auto;

    align-items: center;
    justify-items: center;

    gap: clamp(0.5rem, 2vw, 2rem);

    padding: 4.5rem clamp(0.75rem, 3vw, 3rem) 3.5rem;

    background: rgba(18, 9, 5, 0.94);

    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    transition:
      opacity 250ms ease,
      visibility 250ms ease;

    backdrop-filter: blur(16px);
  }

  .gallery-lightbox.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .lightbox-figure {
    display: flex;
    flex-direction: column;

    align-items: center;
    justify-content: center;

    width: 100%;
    height: 100%;

    min-width: 0;
    margin: 0;
  }

  .lightbox-figure img {
    display: block;

    max-width: min(100%, 1200px);
    max-height: calc(100vh - 8rem);

    width: auto;
    height: auto;

    object-fit: contain;

    border: 1px solid rgba(226, 193, 163, 0.3);
    border-radius: 1rem;

    box-shadow: 0 25px 90px rgba(0, 0, 0, 0.5);
  }

  .lightbox-figure figcaption {
    margin-top: 0.85rem;

    color: rgba(255, 247, 237, 0.75);

    font-size: 0.9rem;
    text-align: center;
  }

  /* =========================================
     BOTONES DEL LIGHTBOX
  ========================================= */

  .lightbox-close,
  .lightbox-nav {
    display: grid;
    place-items: center;

    width: 2.9rem;
    height: 2.9rem;

    border: 1px solid rgba(255, 247, 237, 0.28);
    border-radius: 50%;

    color: var(--gallery-cream);

    background: rgba(255, 247, 237, 0.09);

    cursor: pointer;

    transition:
      background 200ms ease,
      transform 200ms ease;
  }

  .lightbox-close:hover,
  .lightbox-nav:hover {
    transform: scale(1.06);
    background: rgba(217, 166, 109, 0.25);
  }

  .lightbox-close {
    position: absolute;

    top: 1.25rem;
    right: 1.5rem;

    font-size: 2rem;
    line-height: 1;
  }

  .lightbox-nav {
    font-size: 1.15rem;
  }

  .lightbox-counter {
    position: absolute;

    bottom: 1.25rem;
    left: 50%;

    color: rgba(255, 247, 237, 0.65);

    font-size: 0.8rem;
    letter-spacing: 0.12em;

    transform: translateX(-50%);
  }

  /* =========================================
     TABLETS
  ========================================= */

  @media (max-width: 900px) {
    .gallery-grid {
      grid-template-rows:
        repeat(3, clamp(130px, 22vw, 190px));
    }
  }

  /* =========================================
     CELULARES
  ========================================= */

  @media (max-width: 640px) {
    .gallery-section {
      padding: 4.25rem 1rem;
    }

    .gallery-heading {
      margin-bottom: 2rem;
    }

    .gallery-heading h2 {
      font-size: clamp(2rem, 9vw, 2.65rem);
    }

    .gallery-heading p {
      max-width: 28rem;
      margin-inline: auto;
      font-size: 0.9rem;
    }

    .gallery-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: 220px 150px 150px 150px;

      gap: 0.65rem;
    }

    .gallery-item {
      border-radius: 1.1rem;
    }

    .gallery-item--feature {
      grid-column: 1 / -1;
      grid-row: 1;
    }

    .gallery-item--portrait {
      grid-column: 1;
      grid-row: 2 / span 2;
    }

    .gallery-item--top {
      grid-column: 2;
      grid-row: 2;
    }

    .gallery-item--middle {
      grid-column: 2;
      grid-row: 3;
    }

    .gallery-item--bottom:nth-of-type(5) {
      grid-column: 1;
      grid-row: 4;
    }

    .gallery-item--bottom:nth-of-type(6) {
      grid-column: 2;
      grid-row: 4;
    }

    .gallery-item--bottom:nth-of-type(7) {
      grid-column: 1 / -1;
      grid-row: 5;
      height: 180px;
    }

    .gallery-grid {
      grid-template-rows:
        220px 150px 150px 150px 180px;
    }

    /* LIGHTBOX MÓVIL */

    .gallery-lightbox {
      grid-template-columns: 2.4rem minmax(0, 1fr) 2.4rem;

      gap: 0.35rem;

      padding: 4rem 0.35rem 3.5rem;
    }

    .lightbox-nav {
      width: 2.35rem;
      height: 2.35rem;
      font-size: 0.9rem;
    }

    .lightbox-close {
      top: 0.8rem;
      right: 0.8rem;

      width: 2.5rem;
      height: 2.5rem;
    }

    .lightbox-figure img {
      max-width: 100%;
      max-height: calc(100vh - 9rem);

      border-radius: 0.7rem;
    }
  }

  /* =========================================
     ACCESIBILIDAD
  ========================================= */

  @media (prefers-reduced-motion: reduce) {
    .gallery-item img,
    .gallery-item-overlay,
    .gallery-lightbox,
    .lightbox-close,
    .lightbox-nav {
      transition: none;
    }
  }
</style>

<script>
  const galleries = document.querySelectorAll(".gallery-section");

  galleries.forEach((gallery) => {
    const lightbox = document.querySelector("[data-lightbox]");

    if (!lightbox || lightbox.dataset.initialized === "true") return;

    lightbox.dataset.initialized = "true";

    const buttons = Array.from(
      gallery.querySelectorAll("[data-gallery-index]")
    );

    const image = lightbox.querySelector("[data-lightbox-image]");
    const caption = lightbox.querySelector("[data-lightbox-caption]");
    const counter = lightbox.querySelector("[data-lightbox-counter]");

    const closeButton = lightbox.querySelector("[data-lightbox-close]");
    const prevButton = lightbox.querySelector("[data-lightbox-prev]");
    const nextButton = lightbox.querySelector("[data-lightbox-next]");

    let currentIndex = 0;
    let previousFocus = null;

    /* Mostrar fotografía */

    const showImage = (index) => {
      currentIndex = (index + buttons.length) % buttons.length;

      const trigger = buttons[currentIndex];
      const photo = trigger.querySelector("img");

      image.src = photo.currentSrc || photo.src;
      image.alt = photo.alt;

      caption.textContent = photo.alt;

      counter.textContent =
        `${currentIndex + 1} / ${buttons.length}`;
    };

    /* Abrir visor */

    const openLightbox = (index) => {
      previousFocus = document.activeElement;

      showImage(index);

      lightbox.classList.add("is-open");
      lightbox.setAttribute("aria-hidden", "false");

      document.body.style.overflow = "hidden";

      closeButton.focus();
    };

    /* Cerrar visor */

    const closeLightbox = () => {
      lightbox.classList.remove("is-open");

      lightbox.setAttribute("aria-hidden", "true");

      document.body.style.overflow = "";

      image.src = "";

      if (previousFocus instanceof HTMLElement) {
        previousFocus.focus();
      }
    };

    /* Eventos de las fotografías */

    buttons.forEach((button, index) => {
      button.addEventListener("click", () => {
        openLightbox(index);
      });
    });

    /* Navegación */

    closeButton.addEventListener("click", closeLightbox);

    prevButton.addEventListener("click", () => {
      showImage(currentIndex - 1);
    });

    nextButton.addEventListener("click", () => {
      showImage(currentIndex + 1);
    });

    /* Cerrar al pulsar fuera de la imagen */

    lightbox.addEventListener("click", (event) => {
      if (event.target === lightbox) {
        closeLightbox();
      }
    });

    /* Teclado */

    document.addEventListener("keydown", (event) => {
      if (!lightbox.classList.contains("is-open")) return;

      if (event.key === "Escape") {
        closeLightbox();
      }

      if (event.key === "ArrowLeft") {
        showImage(currentIndex - 1);
      }

      if (event.key === "ArrowRight") {
        showImage(currentIndex + 1);
      }
    });
  });
</script>