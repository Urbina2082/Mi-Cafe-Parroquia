
---
const {
  etiqueta = "CONTACTO",
  titulo = "Contáctanos",
  descripcion = "Síguenos en redes o escríbenos. Nos encantará atenderte.",
} = Astro.props;

const telefono = "8616124807";
const telefonoInternacional = "528616124807";
const facebook = "https://www.facebook.com/2009cafe?locale=es_LA";
const correo = "micafeparroquia@gmail.com";
---

<section class="contacto" id="contacto">
  <div class="contacto-card">

    <header class="contacto-header">
      <span class="contacto-etiqueta">{etiqueta}</span>
      <h2>{titulo}</h2>
      <p>{descripcion}</p>
    </header>

    <div class="contacto-links">

      <!-- Teléfono -->
      <a href={`tel:${telefono}`} class="contacto-item">
        <span class="contacto-icono">
          <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2A19.8 19.8 0 0 1 11.19 18a19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.09 3.18 2 2 0 0 1 4.08 1h3a2 2 0 0 1 2 1.72c.12.96.36 1.9.7 2.8a2 2 0 0 1-.45 2.11L8.06 8.9a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.84.58 2.8.7A2 2 0 0 1 22 16.92Z"/>
          </svg>
        </span>

        <span class="contacto-texto">
          <small>Llámanos</small>
          <strong>861 612 4807</strong>
        </span>

        <span class="contacto-flecha">↗</span>
      </a>

      <!-- WhatsApp -->
      <a
        href={`https://wa.me/${telefonoInternacional}`}
        target="_blank"
        rel="noopener noreferrer"
        class="contacto-item"
      >
        <span class="contacto-icono">
          <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5Z"/>
          </svg>
        </span>

        <span class="contacto-texto">
          <small>Escríbenos por</small>
          <strong>WhatsApp</strong>
        </span>

        <span class="contacto-flecha">↗</span>
      </a>

      <!-- Facebook -->
      <a
        href={facebook}
        target="_blank"
        rel="noopener noreferrer"
        class="contacto-item"
      >
        <span class="contacto-icono">
          <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
          </svg>
        </span>

        <span class="contacto-texto">
          <small>Síguenos en</small>
          <strong>Facebook</strong>
        </span>

        <span class="contacto-flecha">↗</span>
      </a>

      <!-- Correo -->
      <a href={`mailto:${correo}`} class="contacto-item">
        <span class="contacto-icono">
          <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <path d="m22 7-10 7L2 7"/>
          </svg>
        </span>

        <span class="contacto-texto">
          <small>Envíanos un correo</small>
          <strong>{correo}</strong>
        </span>

        <span class="contacto-flecha">↗</span>
      </a>

    </div>

  </div>
</section>

<style>
  .contacto {
    width: 100%;
    padding: 45px 24px;
    box-sizing: border-box;
    background: transparent;
    color: #fff8f0;
  }

  .contacto-card {
    width: 100%;
    max-width: 1050px;
    margin: 0 auto;
    padding: 48px 35px;
    box-sizing: border-box;

    display: flex;
    flex-direction: column;
    align-items: center;

    text-align: center;

    background: rgba(116, 65, 43, 0.3);
    border: 1px solid rgba(222, 183, 151, 0.32);
    border-radius: 35px;

    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.04),
      0 15px 35px rgba(0, 0, 0, 0.08);
  }

  .contacto-header {
    width: 100%;
  }

  .contacto-etiqueta {
    display: block;
    margin-bottom: 13px;
    color: #d9a66e;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 5px;
  }

  .contacto-header h2 {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(38px, 4.5vw, 55px);
    font-weight: 400;
    line-height: 1.12;
  }

  .contacto-header > p {
    margin: 14px auto 0;
    color: rgba(255, 245, 235, 0.72);
    font-size: 16px;
    line-height: 1.6;
  }

  /* Enlaces de contacto */

  .contacto-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 13px;
    width: 100%;
    max-width: 720px;
    margin-top: 35px;
    text-align: left;
  }

  .contacto-item {
    display: flex;
    align-items: center;
    gap: 13px;
    min-width: 0;
    padding: 15px 17px;

    border: 1px solid rgba(222, 183, 151, 0.2);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.035);

    color: #fff8f0;
    text-decoration: none;
    transition: background 0.25s ease, border-color 0.25s ease,
      transform 0.25s ease;
  }

  .contacto-item:hover {
    background: rgba(255, 255, 255, 0.09);
    border-color: rgba(217, 166, 110, 0.5);
    transform: translateY(-2px);
  }

  .contacto-icono {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    border-radius: 13px;
    color: #d9a66e;
    background: rgba(217, 166, 110, 0.1);
  }

  .contacto-texto {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .contacto-texto small {
    color: rgba(255, 245, 235, 0.58);
    font-size: 12px;
  }

  .contacto-texto strong {
    overflow-wrap: anywhere;
    color: rgba(255, 248, 240, 0.95);
    font-size: 14px;
    font-weight: 500;
  }

  .contacto-flecha {
    margin-left: auto;
    flex-shrink: 0;
    color: #d9a66e;
    font-size: 19px;
  }

  /* Tablets */

  @media (max-width: 768px) {
    .contacto {
      padding: 40px 20px;
    }

    .contacto-card {
      padding: 40px 25px;
      border-radius: 30px;
    }

    .contacto-header h2 {
      font-size: 43px;
    }

    .contacto-header > p {
      font-size: 15px;
    }

    .contacto-links {
      margin-top: 28px;
    }
  }

  /* Celulares */

  @media (max-width: 520px) {
    .contacto {
      padding: 35px 17px;
    }

    .contacto-card {
      padding: 35px 19px;
      border-radius: 25px;
    }

    .contacto-etiqueta {
      font-size: 11px;
      letter-spacing: 4px;
    }

    .contacto-header h2 {
      font-size: 36px;
    }

    .contacto-header > p {
      font-size: 14px;
    }

    .contacto-links {
      grid-template-columns: 1fr;
      gap: 10px;
      margin-top: 25px;
    }

    .contacto-item {
      padding: 13px 14px;
    }

    .contacto-icono {
      width: 39px;
      height: 39px;
    }

    .contacto-texto strong {
      font-size: 13px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contacto-item {
      transition: none;
    }
  }
</style>
