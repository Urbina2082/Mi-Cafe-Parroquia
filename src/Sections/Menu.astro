const totalItems = sections.reduce((total, section) => total + section.items.length, 0);
---

<section class="menu-section" id="menu">
  <div class="menu-shell">

    <header class="menu-heading">
      <span class="eyebrow">NUESTRO MENÚ</span>
      <h2>{title}</h2>
      <p>{subtitle}</p>
    </header>

    <div class="menu-toolbar">
      <label class="search-box">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m16 16 4 4"></path>
        </svg>
        <input
          id="menu-search"
          type="search"
          placeholder="Buscar platillo, ingrediente o bebida..."
          autocomplete="off"
          aria-label="Buscar en el menú"
        />
        <button id="clear-search" type="button" aria-label="Limpiar búsqueda" hidden>×</button>
      </label>
      <span class="menu-counter">{sections.length} categorías · {totalItems} opciones</span>
    </div>

    <div class="menu-intro" id="menu-intro">
      <div>
        <span class="eyebrow">DESCUBRE NUESTROS SABORES</span>
        <h3>¿Qué se te antoja hoy?</h3>
        <p>Explora nuestras categorías y descubre tus platillos favoritos. Selecciona una categoría para consultar sus opciones y precios.</p>
      </div>
      <div class="intro-image">
        <img src={image} alt={imageAlt} loading="lazy" />
        <span>MI CAFÉ PARROQUIA</span>
      </div>
    </div>

    <!-- Categorías: los productos no se muestran hasta seleccionar una -->
    <div class="categories" id="categories">
      {sections.map((section) => (
        <button class="category-card" type="button" data-category={section.id}>
          <span class="category-name">{section.name}</span>
          <span class="category-count">{section.items.length} opciones</span>
          <span class="category-arrow">↗</span>
        </button>
      ))}
    </div>

    <!-- Productos -->
    <div class="menu-detail" id="menu-detail" hidden>
      <div class="detail-toolbar">
        <button type="button" id="back-categories" class="back-button">
          <span>←</span> Todas las categorías
        </button>
        <span id="results-count" class="results-count"></span>
      </div>

      <div id="menu-groups">
        {sections.map((section) => (
          <section class="menu-group" data-section={section.id} hidden>
            <div class="group-heading">
              <div>
                <span class="eyebrow">MI CAFÉ PARROQUIA</span>
                <h3>{section.name}</h3>
              </div>
              <span class="group-count">{section.items.length} opciones</span>
            </div>

            {section.description && (
              <p class="group-description">{section.description}</p>
            )}

            <div class="products-grid">
              {section.items.map((item) => (
                <article
                  class="product-card"
                  data-search={`${section.name} ${item.name} ${item.description ?? ""} ${item.note ?? ""}`}
                >
                  <div class="product-heading">
                    <h4>{item.name}</h4>
                    <span class="price">{item.price}</span>
                  </div>
                  {item.description && <p>{item.description}</p>}
                  {item.note && <span class="product-note">{item.note}</span>}
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>

      <div class="empty-state" id="empty-state" hidden>
        <span>⌕</span>
        <h3>No encontramos ese platillo</h3>
        <p>Prueba con otro nombre o ingrediente.</p>
        <button type="button" id="reset-search">Limpiar búsqueda</button>
      </div>
    </div>

    <footer class="menu-footer">
      <span>PRECIOS EN PESOS MEXICANOS ({currency})</span>
      <span>Los precios y disponibilidad pueden cambiar sin previo aviso.</span>
    </footer>

  </div>
</section>

<script>
  const root = document.querySelector("#menu");

  if (root && root.dataset.ready !== "true") {
    root.dataset.ready = "true";

    const search = root.querySelector("#menu-search");
    const clearSearch = root.querySelector("#clear-search");
    const categories = root.querySelector("#categories");
    const intro = root.querySelector("#menu-intro");
    const detail = root.querySelector("#menu-detail");
    const groups = [...root.querySelectorAll(".menu-group")];
    const cards = [...root.querySelectorAll(".category-card")];
    const back = root.querySelector("#back-categories");
    const resultsCount = root.querySelector("#results-count");
    const emptyState = root.querySelector("#empty-state");
    const resetSearch = root.querySelector("#reset-search");

    let activeCategory = null;

    const normalize = (value) =>
      value.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim();

    function showCategories() {
      activeCategory = null;
      search.value = "";
      intro.hidden = false;
      categories.hidden = false;
      detail.hidden = true;
      clearSearch.hidden = true;
      emptyState.hidden = true;
      groups.forEach(group => group.hidden = true);
    }

    function showCategory(id) {
      activeCategory = id;
      search.value = "";
      intro.hidden = true;
      categories.hidden = true;
      detail.hidden = false;
      clearSearch.hidden = true;
      emptyState.hidden = true;

      groups.forEach(group => {
        const selected = group.dataset.section === id;
        group.hidden = !selected;

        group.querySelectorAll(".product-card").forEach(item => {
          item.hidden = false;
        });
      });

      const selectedGroup = groups.find(group => group.dataset.section === id);
      const count = selectedGroup?.querySelectorAll(".product-card").length || 0;

      resultsCount.textContent = `${count} ${count === 1 ? "opción" : "opciones"}`;
    }

    function searchProducts() {
      const query = normalize(search.value);

      if (!query) {
        if (activeCategory) showCategory(activeCategory);
        else showCategories();
        return;
      }

      activeCategory = null;
      intro.hidden = true;
      categories.hidden = true;
      detail.hidden = false;
      clearSearch.hidden = false;

      let total = 0;

      groups.forEach(group => {
        let matches = 0;

        group.querySelectorAll(".product-card").forEach(item => {
          const text = normalize(item.dataset.search);
          const found = text.includes(query);

          item.hidden = !found;

          if (found) {
            matches++;
            total++;
          }
        });

        group.hidden = matches === 0;
      });

      resultsCount.textContent = `${total} resultados`;
      emptyState.hidden = total > 0;
    }

    cards.forEach(card => {
      card.addEventListener("click", () => {
        showCategory(card.dataset.category);
        detail.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });

    back.addEventListener("click", () => {
      showCategories();
      root.scrollIntoView({ behavior: "smooth", block: "start" });
    });

    search.addEventListener("input", searchProducts);

    clearSearch.addEventListener("click", () => {
      search.value = "";
      searchProducts();
      search.focus();
    });

    resetSearch.addEventListener("click", () => {
      search.value = "";
      showCategories();
      search.focus();
    });
  }
</script>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap');

  .menu-section {
    --cream: #fff7ee;
    --muted: rgba(255,241,226,.68);
    --gold: #d8a66f;
    --line: rgba(255,226,203,.22);

    position: relative;
    overflow: hidden;
    padding: clamp(48px, 5vw, 76px) clamp(16px, 5vw, 76px);
    color: var(--cream);
    font-family: 'DM Sans', sans-serif;
   
  }

  .menu-section *,
  .menu-section *::before,
  .menu-section *::after {
    box-sizing: border-box;
  }

  .menu-shell {
    width: 100%;
    max-width: 1320px;
    margin-inline: auto;
  }

  .menu-heading {
    text-align: center;
    margin-bottom: 30px;
  }

  .eyebrow {
    display: inline-block;
    color: var(--gold);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .32em;
  }

  .menu-heading h2 {
    margin: 10px 0;
    font: 500 clamp(34px, 3.7vw, 52px)/1.12 'Playfair Display', Georgia, serif;
    letter-spacing: -.035em;
  }

  .menu-heading p {
    margin: 0;
    color: var(--muted);
    font-size: clamp(13px, 1.1vw, 16px);
    line-height: 1.6;
  }

  /* BUSCADOR */

  .menu-toolbar {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 9px;
    margin-bottom: 25px;
  }

  .search-box {
    display: flex;
    align-items: center;
    width: min(100%, 570px);
    min-height: 48px;
    padding: 0 15px;
    border: 1px solid rgba(255,231,211,.3);
    border-radius: 40px;
    background: rgba(35,17,10,.34);
    transition: .25s ease;
  }

  .search-box:focus-within {
    border-color: var(--gold);
    box-shadow: 0 0 0 3px rgba(216,166,111,.09);
  }

  .search-box svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    fill: none;
    stroke: var(--muted);
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  .search-box input {
    width: 100%;
    min-width: 0;
    padding: 12px;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--cream);
    font: 13px 'DM Sans', sans-serif;
